#pragma once

namespace tgcli {

inline constexpr const char* kVersion = "@TGCLI_VERSION@";

// Short HEAD revision of the tree this binary was built from, with a
// `-dirty` suffix for modified tracked files. Empty when the source is not a
// trustworthy git work-tree root or its identity cannot be inspected.
inline constexpr const char* kBuildCommit = "@TGCLI_BUILD_COMMIT@";

} // namespace tgcli
