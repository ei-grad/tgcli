{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tgcli msg react result",
  "$defs": {
    "int53": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "not": { "const": 0 }
    },
    "chatIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "is_bot", "usernames"],
      "properties": {
        "id": { "$ref": "#/$defs/int53" },
        "title": { "type": "string" },
        "type": { "enum": ["private", "basic_group", "supergroup", "channel"] },
        "is_bot": { "type": "boolean" },
        "usernames": { "type": "array", "maxItems": 100, "items": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,32}$" } }
      }
    },
    "addPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "account", "tdlib_request", "chat", "message_id", "reaction", "remove", "big"],
      "properties": {
        "operation": { "const": "msg_react" },
        "account": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
        "tdlib_request": { "const": "addMessageReaction" },
        "chat": { "$ref": "#/$defs/chatIdentity" },
        "message_id": { "$ref": "#/$defs/int53" },
        "reaction": { "type": "string", "minLength": 1, "maxLength": 64 },
        "remove": { "const": false },
        "big": { "type": "boolean" }
      }
    },
    "removePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "account", "tdlib_request", "chat", "message_id", "reaction", "remove", "big"],
      "properties": {
        "operation": { "const": "msg_react" },
        "account": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
        "tdlib_request": { "const": "removeMessageReaction" },
        "chat": { "$ref": "#/$defs/chatIdentity" },
        "message_id": { "$ref": "#/$defs/int53" },
        "reaction": { "type": "string", "minLength": 1, "maxLength": 64 },
        "remove": { "const": true },
        "big": { "const": false }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["chat_id", "message_id", "reaction", "removed", "big"],
      "properties": {
        "chat_id": { "$ref": "#/$defs/int53" },
        "message_id": { "$ref": "#/$defs/int53" },
        "reaction": { "type": "string", "minLength": 1, "maxLength": 64 },
        "removed": { "const": false },
        "big": { "type": "boolean" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["chat_id", "message_id", "reaction", "removed", "big"],
      "properties": {
        "chat_id": { "$ref": "#/$defs/int53" },
        "message_id": { "$ref": "#/$defs/int53" },
        "reaction": { "type": "string", "minLength": 1, "maxLength": 64 },
        "removed": { "const": true },
        "big": { "const": false }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["dry_run", "plan"],
      "properties": {
        "dry_run": { "const": true },
        "plan": { "oneOf": [{ "$ref": "#/$defs/addPlan" }, { "$ref": "#/$defs/removePlan" }] }
      }
    }
  ]
}
