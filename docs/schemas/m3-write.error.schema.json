{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tgcli public M3 write error",
  "$defs": {
    "account": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
    "int53": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "not": { "const": 0 }
    },
    "positiveInt53": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "hex32": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "operation": { "enum": ["send", "msg_edit", "msg_delete", "msg_react", "msg_pin", "msg_unpin", "chat_mark_read", "chat_mute", "chat_unmute", "chat_pin", "chat_unpin", "chat_archive", "chat_unarchive", "chat_join", "chat_leave", "saved_attach", "resolve"] },
    "state": {
      "enum": ["unknown", "wait_tdlib_parameters", "wait_phone_number", "wait_premium_purchase", "wait_email_address", "wait_email_code", "wait_code", "wait_other_device_confirmation", "wait_registration", "wait_password", "ready", "logging_out", "closing", "closed"]
    },
    "durabilityReason": {
      "enum": ["path_invalid", "wrong_owner", "wrong_type", "wrong_mode", "wrong_link_count", "too_large", "capacity_exhausted", "open_failed", "lock_failed", "read_failed", "write_failed", "sync_failed", "rename_failed", "directory_sync_failed", "parse_error", "schema_error", "contradiction"]
    },
    "filesystemDiagnosticPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "bytes_hex" },
        "value": {
          "type": "string",
          "pattern": "^2f(?:0[1-9a-f]|[1-9a-f][0-9a-f])+$"
        }
      }
    },
    "configReason": {
      "enum": ["path_invalid", "wrong_owner", "wrong_type", "wrong_mode", "wrong_link_count", "too_large", "parse_error", "type_error", "invalid_default", "conflicting_credentials", "io_error", "sync_error"]
    },
    "v2Stage": {
      "enum": ["idempotency_pending", "spool_ready", "dispatch_started", "temporary_ids_observed", "forward_progress", "mutation_confirmed"]
    },
    "chatIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "is_bot", "usernames"],
      "properties": {
        "id": { "$ref": "#/$defs/int53" },
        "title": { "type": "string" },
        "type": { "enum": ["private", "basic_group", "supergroup", "channel"] },
        "is_bot": { "type": "boolean" },
        "usernames": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,32}$" }
        }
      }
    },
    "leaveChatIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "is_bot", "usernames"],
      "properties": {
        "id": { "$ref": "#/$defs/int53" },
        "title": { "type": "string" },
        "type": { "enum": ["basic_group", "supergroup", "channel"] },
        "is_bot": { "type": "boolean" },
        "usernames": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,32}$" }
        }
      }
    },
    "forumTopic": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "forum" },
            "id": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
          }
        }
      ]
    },
    "schedule": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "online" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "send_date"],
          "properties": {
            "kind": { "const": "at" },
            "send_date": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
          }
        }
      ]
    },
    "messageWriteResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chat_id", "date", "sender", "is_outgoing", "topic", "type", "text", "scheduled"],
      "properties": {
        "id": { "$ref": "#/$defs/int53" },
        "chat_id": { "$ref": "#/$defs/int53" },
        "date": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }] },
        "sender": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": { "type": { "const": "user" }, "id": { "$ref": "#/$defs/positiveInt53" } } },
            { "type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": { "type": { "const": "chat" }, "id": { "$ref": "#/$defs/int53" } } }
          ]
        },
        "is_outgoing": { "type": "boolean" },
        "topic": {
          "oneOf": [
            { "type": "null" },
            { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "const": "forum" }, "id": { "type": "integer", "minimum": 1, "maximum": 2147483647 } } },
            { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "enum": ["thread", "direct", "saved"] }, "id": { "$ref": "#/$defs/positiveInt53" } } }
          ]
        },
        "type": { "enum": ["text", "photo", "video", "doc", "voice", "other"] },
        "text": { "type": "string" },
        "scheduled": { "type": "boolean" }
      },
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "chat_id", "date", "sender", "is_outgoing", "topic", "type", "text", "scheduled"],
          "properties": { "id": { "$ref": "#/$defs/int53" }, "chat_id": { "$ref": "#/$defs/int53" }, "date": { "type": "null" }, "sender": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": { "type": { "const": "user" }, "id": { "$ref": "#/$defs/positiveInt53" } } }, { "type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": { "type": { "const": "chat" }, "id": { "$ref": "#/$defs/int53" } } }] }, "is_outgoing": { "type": "boolean" }, "topic": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "const": "forum" }, "id": { "type": "integer", "minimum": 1, "maximum": 2147483647 } } }, { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "enum": ["thread", "direct", "saved"] }, "id": { "$ref": "#/$defs/positiveInt53" } } }] }, "type": { "enum": ["text", "photo", "video", "doc", "voice", "other"] }, "text": { "type": "string" }, "scheduled": { "const": true } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "chat_id", "date", "sender", "is_outgoing", "topic", "type", "text", "scheduled"],
          "properties": { "id": { "$ref": "#/$defs/int53" }, "chat_id": { "$ref": "#/$defs/int53" }, "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }, "sender": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": { "type": { "const": "user" }, "id": { "$ref": "#/$defs/positiveInt53" } } }, { "type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": { "type": { "const": "chat" }, "id": { "$ref": "#/$defs/int53" } } }] }, "is_outgoing": { "type": "boolean" }, "topic": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "const": "forum" }, "id": { "type": "integer", "minimum": 1, "maximum": 2147483647 } } }, { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "enum": ["thread", "direct", "saved"] }, "id": { "$ref": "#/$defs/positiveInt53" } } }] }, "type": { "enum": ["text", "photo", "video", "doc", "voice", "other"] }, "text": { "type": "string" }, "scheduled": { "const": false } }
        }
      ]
    },
    "forwardPendingItem": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "status", "temporary_message_id"],
      "properties": { "source_id": { "$ref": "#/$defs/int53" }, "status": { "const": "pending" }, "temporary_message_id": { "$ref": "#/$defs/int53" } }
    },
    "forwardSentItem": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "status", "message"],
      "properties": { "source_id": { "$ref": "#/$defs/int53" }, "status": { "const": "sent" }, "message": { "$ref": "#/$defs/messageWriteResult" } }
    },
    "forwardFailedItem": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["source_id", "status", "failure_reason", "tdlib_code", "retry_after"],
          "properties": { "source_id": { "$ref": "#/$defs/int53" }, "status": { "const": "failed" }, "failure_reason": { "enum": ["upstream_null", "deleted_before_confirmation"] }, "tdlib_code": { "type": "null" }, "retry_after": { "type": "null" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["source_id", "status", "failure_reason", "tdlib_code", "retry_after"],
          "properties": { "source_id": { "$ref": "#/$defs/int53" }, "status": { "const": "failed" }, "failure_reason": { "const": "tdlib_error" }, "tdlib_code": { "type": "integer", "not": { "const": 429 } }, "retry_after": { "type": "null" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["source_id", "status", "failure_reason", "tdlib_code", "retry_after"],
          "properties": { "source_id": { "$ref": "#/$defs/int53" }, "status": { "const": "failed" }, "failure_reason": { "const": "tdlib_error" }, "tdlib_code": { "const": 429 }, "retry_after": { "type": "integer", "minimum": 0 } }
        }
      ]
    },
    "forwardRateFailedItem": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "status", "failure_reason", "tdlib_code", "retry_after"],
      "properties": { "source_id": { "$ref": "#/$defs/int53" }, "status": { "const": "failed" }, "failure_reason": { "const": "tdlib_error" }, "tdlib_code": { "const": 429 }, "retry_after": { "type": "integer", "minimum": 0 } }
    },
    "forwardItem": {
      "oneOf": [
        { "$ref": "#/$defs/forwardPendingItem" },
        { "$ref": "#/$defs/forwardSentItem" },
        { "$ref": "#/$defs/forwardFailedItem" }
      ]
    },
    "forwardItems": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": { "$ref": "#/$defs/forwardItem" }
    },
    "forwardTerminalItems": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": { "oneOf": [{ "$ref": "#/$defs/forwardSentItem" }, { "$ref": "#/$defs/forwardFailedItem" }] }
    },
    "forwardRateItems": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": { "$ref": "#/$defs/forwardRateFailedItem" }
    },
    "forwardFailedItems": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": { "$ref": "#/$defs/forwardFailedItem" }
    },
    "ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/int53" }
    },
    "sendPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "account", "tdlib_request", "chat", "text", "parse_mode", "reply_to", "requested_topic", "effective_topic", "silent", "schedule", "observed_server_unix_time"],
      "properties": {
        "operation": { "const": "send" },
        "account": { "$ref": "#/$defs/account" },
        "tdlib_request": { "const": "sendMessage" },
        "chat": { "$ref": "#/$defs/chatIdentity" },
        "text": { "type": "string", "minLength": 1 },
        "parse_mode": { "enum": ["plain", "markdown_v2", "html"] },
        "reply_to": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/int53" }] },
        "requested_topic": { "$ref": "#/$defs/forumTopic" },
        "effective_topic": { "$ref": "#/$defs/forumTopic" },
        "silent": { "type": "boolean" },
        "schedule": { "$ref": "#/$defs/schedule" },
        "observed_server_unix_time": { "type": ["integer", "null"] }
      }
    },
    "deletePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "account", "tdlib_request", "chat", "message_ids", "requested_for_all", "effective_for_all"],
      "properties": {
        "operation": { "const": "msg_delete" },
        "account": { "$ref": "#/$defs/account" },
        "tdlib_request": { "const": "deleteMessages" },
        "chat": { "$ref": "#/$defs/chatIdentity" },
        "message_ids": { "$ref": "#/$defs/ids" },
        "requested_for_all": { "type": "boolean" },
        "effective_for_all": { "type": "boolean" }
      }
    },
    "leavePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "account", "tdlib_request", "chat"],
      "properties": {
        "operation": { "const": "chat_leave" },
        "account": { "$ref": "#/$defs/account" },
        "tdlib_request": { "const": "leaveChat" },
        "chat": { "$ref": "#/$defs/leaveChatIdentity" }
      }
    },
    "errorBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "details"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "details": {}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "allOf": [
        { "$ref": "#/$defs/errorBase" },
        {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "details"],
              "properties": {
                "message": { "type": "string" },
                "code": { "const": "USAGE" },
                "details": {
                  "oneOf": [
                    { "type": "object", "additionalProperties": false, "maxProperties": 0 },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["argument", "reason"],
                      "properties": {
                        "argument": { "type": ["string", "null"] },
                        "reason": { "enum": ["missing_argument", "invalid_argument", "mutually_exclusive", "unknown_command", "invalid_environment", "unsupported_mode", "unsupported_topic_kind", "unsupported_link_type", "unsupported_chat_type"] }
                      }
                    }
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "details"],
              "properties": {
                "message": { "type": "string" },
                "code": { "const": "ACCOUNT_NOT_FOUND" },
                "details": {
                  "type": "object", "additionalProperties": false,
                  "required": ["account"],
                  "properties": { "account": { "$ref": "#/$defs/account" } }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "details"],
              "properties": {
                "message": { "type": "string" },
                "code": { "const": "ACCOUNT_MISMATCH" },
                "details": {
                  "type": "object", "additionalProperties": false,
                  "required": ["requested_account", "daemon_account"],
                  "properties": {
                    "requested_account": { "$ref": "#/$defs/account" },
                    "daemon_account": { "$ref": "#/$defs/account" }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "details"],
              "properties": {
                "message": { "type": "string" },
                "code": { "const": "CONFIG_INVALID" },
                "details": {
                  "type": "object", "additionalProperties": false,
                  "required": ["path", "reason"],
                  "properties": { "path": { "type": "string", "pattern": "^/" }, "reason": { "$ref": "#/$defs/configReason" } }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "details"],
              "properties": {
                "message": { "type": "string" },
                "code": { "const": "CONFIG_CONFLICT" },
                "details": {
                  "type": "object", "additionalProperties": false,
                  "required": ["path", "expected", "current"],
                  "properties": { "path": { "type": "string", "pattern": "^/" }, "expected": { "type": "string" }, "current": { "type": "string" } }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "details"],
              "properties": {
                "message": { "type": "string" },
                "code": { "const": "WRITE_DENIED" },
                "details": {
                  "type": "object", "additionalProperties": false,
                  "required": ["account", "reason"],
                  "properties": { "account": { "$ref": "#/$defs/account" }, "reason": { "enum": ["explicit_deny", "no_grant", "invalid_config_grant"] } }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "details"],
              "properties": {
                "message": { "type": "string" },
                "code": { "const": "BOT_UNSUPPORTED" },
                "details": {
                  "type": "object", "additionalProperties": false,
                  "required": ["operation"],
                  "properties": { "operation": { "enum": ["send", "msg_react", "chat_mark_read", "chat_mute", "chat_unmute", "chat_pin", "chat_unpin", "chat_archive", "chat_unarchive", "chat_join"] } }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "details"],
              "properties": {
                "message": { "const": "saved commands require a user account" },
                "code": { "const": "BOT_UNSUPPORTED" },
                "details": { "const": {} }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "details"],
              "properties": {
                "message": { "type": "string" },
                "code": { "const": "NOT_AUTHED" },
                "details": {
                  "type": "object", "additionalProperties": false,
                  "required": ["account", "state", "reason"],
                  "properties": { "account": { "$ref": "#/$defs/account" }, "state": { "$ref": "#/$defs/state" }, "reason": { "enum": ["not_ready", "authorization_lost", "login_required"] } }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "details"],
              "properties": {
                "message": { "type": "string" },
                "code": { "const": "NOT_FOUND" },
                "details": {
                  "oneOf": [
                    {
                      "type": "object", "additionalProperties": false,
                      "required": ["selector"],
                      "properties": { "selector": { "type": "string" } }
                    },
                    {
                      "type": "object", "additionalProperties": false,
                      "required": ["chat_id", "message_id"],
                      "properties": { "chat_id": { "$ref": "#/$defs/int53" }, "message_id": { "$ref": "#/$defs/int53" } }
                    }
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "details"],
              "properties": {
                "message": { "const": "input file is unavailable" },
                "code": { "const": "NOT_FOUND" },
                "details": {
                  "type": "object", "additionalProperties": false,
                  "required": ["operation", "path", "reason"],
                  "properties": {
                    "operation": { "const": "saved_attach" },
                    "path": { "type": "string", "pattern": "^/", "maxLength": 4096 },
                    "reason": { "enum": ["missing", "symlink", "wrong_type", "empty", "unreadable"] }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "details"],
              "properties": {
                "message": { "type": "string" },
                "code": { "const": "AMBIGUOUS" },
                "details": {
                  "type": "object", "additionalProperties": false,
                  "required": ["selector", "scope", "candidates", "truncated"],
                  "properties": {
                    "selector": { "type": "string" },
                    "scope": { "const": "active_dialogs" },
                    "candidates": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/chatIdentity" } },
                    "truncated": { "type": "boolean" }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "details"],
              "properties": {
                "message": { "type": "string" },
                "code": { "const": "RATE_LIMITED" },
                "details": {
                  "oneOf": [
                    {
                      "type": "object", "additionalProperties": false,
                      "required": ["operation", "tdlib_code", "retry_after"],
                      "properties": { "operation": { "$ref": "#/$defs/operation" }, "tdlib_code": { "const": 429 }, "retry_after": { "type": "integer", "minimum": 0 } }
                    },
                    {
                      "type": "object", "additionalProperties": false,
                      "required": ["operation", "tdlib_code", "retry_after", "items"],
                      "properties": { "operation": { "const": "msg_forward" }, "tdlib_code": { "const": 429 }, "retry_after": { "type": "integer", "minimum": 0 }, "items": { "oneOf": [{ "type": "array", "maxItems": 0 }, { "$ref": "#/$defs/forwardRateItems" }] } }
                    }
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "details"],
              "properties": {
                "message": { "type": "string" },
                "code": { "const": "TDLIB_ERROR" },
                "details": {
                  "type": "object", "additionalProperties": false,
                  "required": ["operation", "tdlib_code"],
                  "properties": {
                    "operation": { "oneOf": [{ "$ref": "#/$defs/operation" }, { "const": "msg_forward" }] },
                    "tdlib_code": { "type": "integer" }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "details"],
              "properties": {
                "message": { "type": "string" },
                "code": { "const": "INTERNAL" },
                "details": {
                  "type": "object", "additionalProperties": false,
                  "required": ["operation", "reason"],
                  "properties": { "operation": { "oneOf": [{ "$ref": "#/$defs/operation" }, { "const": "msg_forward" }] }, "reason": { "const": "internal_error" } }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message", "details"],
              "properties": {
                "message": { "type": "string" },
                "code": { "const": "PRECONDITION_FAILED" },
                "details": {
                  "oneOf": [
                    {
                      "type": "object", "additionalProperties": false,
                      "required": ["operation", "chat_id", "message_id", "reason"],
                      "properties": {
