{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "int53_nonzero": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "not": { "const": 0 }
    },
    "uint64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "timestamp": {
      "type": "string",
      "oneOf": [
        {
          "pattern": "^1901-12-(?:13T(?:20:(?:45:(?:5[2-9])|(?:4[6-9]|5[0-9]):[0-5][0-9])|2[1-3]:[0-5][0-9]:[0-5][0-9])|(?:1[4-9]|2[0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9])Z$"
        },
        {
          "pattern": "^(?:190[2-9]|19[1-9][0-9]|20[0-2][0-9]|203[0-7])-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        },
        {
          "pattern": "^(?:19(?:0[48]|[2468][048]|[13579][26])|2000|20(?:0[48]|1[26]|2[048]|3[26]))-02-29T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        },
        {
          "pattern": "^2038-01-(?:(?:0[1-9]|1[0-8])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]|19T(?:0[0-2]:[0-5][0-9]:[0-5][0-9]|03:(?:0[0-9]|1[0-3]):[0-5][0-9]|03:14:0[0-7]))Z$"
        }
      ]
    },
    "limit_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "all", "since"],
      "properties": {
        "limit": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "all": { "const": false },
        "since": {
          "oneOf": [
            { "$ref": "#/$defs/timestamp" },
            { "type": "null" }
          ]
        }
      }
    },
    "since_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "all", "since"],
      "properties": {
        "limit": { "type": "null" },
        "all": { "const": false },
        "since": { "$ref": "#/$defs/timestamp" }
      }
    },
    "all_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "all", "since"],
      "properties": {
        "limit": { "type": "null" },
        "all": { "const": true },
        "since": {
          "oneOf": [
            { "$ref": "#/$defs/timestamp" },
            { "type": "null" }
          ]
        }
      }
    },
    "limit_since_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "all", "since"],
      "properties": {
        "limit": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "all": { "const": false },
        "since": { "$ref": "#/$defs/timestamp" }
      }
    },
    "all_since_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "all", "since"],
      "properties": {
        "limit": { "type": "null" },
        "all": { "const": true },
        "since": { "$ref": "#/$defs/timestamp" }
      }
    },
    "bare_all_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "all", "since"],
      "properties": {
        "limit": { "type": "null" },
        "all": { "const": true },
        "since": { "type": "null" }
      }
    },
    "target": {
      "oneOf": [
        { "$ref": "#/$defs/limit_target" },
        { "$ref": "#/$defs/since_target" },
        { "$ref": "#/$defs/all_target" }
      ]
    },
    "count_zero_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chat_id", "cached_count", "oldest_message_id", "target", "target_reached", "stop_reason", "resume_from_message_id"],
      "properties": {
        "chat_id": { "$ref": "#/$defs/int53_nonzero" },
        "cached_count": { "const": 0 },
        "oldest_message_id": { "type": "null" },
        "target": { "$ref": "#/$defs/target" },
        "target_reached": { "oneOf": [{ "type": "boolean" }, { "type": "null" }] },
        "stop_reason": { "enum": ["target_reached", "since_anchor_reached", "tdlib_idle"] },
        "resume_from_message_id": { "type": "null" }
      }
    },
    "count_nonzero_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chat_id", "cached_count", "oldest_message_id", "target", "target_reached", "stop_reason", "resume_from_message_id"],
      "properties": {
        "chat_id": { "$ref": "#/$defs/int53_nonzero" },
        "cached_count": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "oldest_message_id": { "$ref": "#/$defs/int53_nonzero" },
        "target": { "$ref": "#/$defs/target" },
        "target_reached": { "oneOf": [{ "type": "boolean" }, { "type": "null" }] },
        "stop_reason": { "enum": ["target_reached", "since_anchor_reached", "tdlib_idle"] },
        "resume_from_message_id": { "$ref": "#/$defs/int53_nonzero" }
      }
    },
    "target_reached_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chat_id", "cached_count", "oldest_message_id", "target", "target_reached", "stop_reason", "resume_from_message_id"],
      "properties": {
        "chat_id": { "$ref": "#/$defs/int53_nonzero" },
        "cached_count": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "oldest_message_id": { "$ref": "#/$defs/int53_nonzero" },
        "target": { "$ref": "#/$defs/limit_target" },
        "target_reached": { "const": true },
        "stop_reason": { "const": "target_reached" },
        "resume_from_message_id": { "$ref": "#/$defs/int53_nonzero" }
      }
    },
    "since_reached_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chat_id", "cached_count", "oldest_message_id", "target", "target_reached", "stop_reason", "resume_from_message_id"],
      "properties": {
        "chat_id": { "$ref": "#/$defs/int53_nonzero" },
        "cached_count": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
        "oldest_message_id": { "$ref": "#/$defs/int53_nonzero" },
        "target": { "oneOf": [{ "$ref": "#/$defs/limit_since_target" }, { "$ref": "#/$defs/since_target" }, { "$ref": "#/$defs/all_since_target" }] },
        "target_reached": { "const": true },
        "stop_reason": { "const": "since_anchor_reached" },
        "resume_from_message_id": { "$ref": "#/$defs/int53_nonzero" }
      }
    },
    "finite_idle_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chat_id", "cached_count", "oldest_message_id", "target", "target_reached", "stop_reason", "resume_from_message_id"],
      "properties": {
        "chat_id": { "$ref": "#/$defs/int53_nonzero" },
        "cached_count": { "$ref": "#/$defs/uint64" },
        "oldest_message_id": { "oneOf": [{ "$ref": "#/$defs/int53_nonzero" }, { "type": "null" }] },
        "target": { "oneOf": [{ "$ref": "#/$defs/limit_target" }, { "$ref": "#/$defs/since_target" }, { "$ref": "#/$defs/all_since_target" }] },
        "target_reached": { "const": false },
        "stop_reason": { "const": "tdlib_idle" },
        "resume_from_message_id": { "oneOf": [{ "$ref": "#/$defs/int53_nonzero" }, { "type": "null" }] }
      }
    },
    "unbounded_idle_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chat_id", "cached_count", "oldest_message_id", "target", "target_reached", "stop_reason", "resume_from_message_id"],
      "properties": {
        "chat_id": { "$ref": "#/$defs/int53_nonzero" },
        "cached_count": { "$ref": "#/$defs/uint64" },
        "oldest_message_id": { "oneOf": [{ "$ref": "#/$defs/int53_nonzero" }, { "type": "null" }] },
        "target": { "$ref": "#/$defs/bare_all_target" },
        "target_reached": { "type": "null" },
        "stop_reason": { "const": "tdlib_idle" },
        "resume_from_message_id": { "oneOf": [{ "$ref": "#/$defs/int53_nonzero" }, { "type": "null" }] }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chat_id",
    "cached_count",
    "oldest_message_id",
    "target",
    "target_reached",
    "stop_reason",
    "resume_from_message_id"
  ],
  "properties": {
    "chat_id": { "$ref": "#/$defs/int53_nonzero" },
    "cached_count": { "$ref": "#/$defs/uint64" },
    "oldest_message_id": {
      "oneOf": [
        { "$ref": "#/$defs/int53_nonzero" },
        { "type": "null" }
      ]
    },
    "target": { "$ref": "#/$defs/target" },
    "target_reached": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "stop_reason": { "enum": ["target_reached", "since_anchor_reached", "tdlib_idle"] },
    "resume_from_message_id": {
      "oneOf": [
        { "$ref": "#/$defs/int53_nonzero" },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "oneOf": [
        { "$ref": "#/$defs/count_zero_result" },
        { "$ref": "#/$defs/count_nonzero_result" }
      ]
    },
    {
      "oneOf": [
        { "$ref": "#/$defs/target_reached_result" },
        { "$ref": "#/$defs/since_reached_result" },
        { "$ref": "#/$defs/finite_idle_result" },
        { "$ref": "#/$defs/unbounded_idle_result" }
      ]
    }
  ]
}
