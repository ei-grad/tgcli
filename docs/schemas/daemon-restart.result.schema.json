{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tgcli daemon restart result",
  "type": "object",
  "additionalProperties": false,
  "required": ["account", "restarted", "pid", "version", "protocol", "socket"],
  "properties": {
    "account": { "type": "string" },
    "restarted": { "const": true },
    "pid": { "type": "integer", "minimum": 1 },
    "version": { "type": "string" },
    "protocol": { "type": "integer" },
    "socket": { "type": "string", "pattern": "^/" }
  }
}
