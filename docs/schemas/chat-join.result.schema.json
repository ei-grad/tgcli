{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tgcli chat join result",
  "$defs": {
    "int53": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991, "not": { "const": 0 } },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "chat": { "type": "object", "additionalProperties": false, "required": ["id", "title", "type", "is_bot", "usernames"], "properties": { "id": { "$ref": "#/$defs/int53" }, "title": { "type": "string" }, "type": { "enum": ["private", "basic_group", "supergroup", "channel"] }, "is_bot": { "type": "boolean" }, "usernames": { "type": "array", "maxItems": 100, "items": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,32}$" } } } },
    "plan": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["operation", "account", "tdlib_request", "source", "chat", "invite_link_sha256"], "properties": { "operation": { "const": "chat_join" }, "account": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" }, "tdlib_request": { "const": "joinChat" }, "source": { "const": "username" }, "chat": { "$ref": "#/$defs/chat" }, "invite_link_sha256": { "const": null } } },
        { "type": "object", "additionalProperties": false, "required": ["operation", "account", "tdlib_request", "source", "chat", "invite_link_sha256"], "properties": { "operation": { "const": "chat_join" }, "account": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" }, "tdlib_request": { "const": "joinChatByInviteLink" }, "source": { "const": "invite_link" }, "chat": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/chat" }] }, "invite_link_sha256": { "$ref": "#/$defs/hash" } } }
      ]
    }
  },
  "oneOf": [
    { "type": "object", "additionalProperties": false, "required": ["status", "chat_id"], "properties": { "status": { "const": "joined" }, "chat_id": { "$ref": "#/$defs/int53" } } },
    { "type": "object", "additionalProperties": false, "required": ["status", "chat_id"], "properties": { "status": { "const": "request_sent" }, "chat_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/int53" }] } } },
    { "type": "object", "additionalProperties": false, "required": ["dry_run", "plan"], "properties": { "dry_run": { "const": true }, "plan": { "$ref": "#/$defs/plan" } } }
  ]
}
