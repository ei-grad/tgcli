{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tgcli send result",
  "$defs": {
    "int53Nonzero": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "not": { "const": 0 }
    },
    "positiveInt53": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "topic": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "forum" },
            "id": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["thread", "direct", "saved"] },
            "id": { "$ref": "#/$defs/positiveInt53" }
          }
        }
      ]
    },
    "sender": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": { "const": "user" },
            "id": { "$ref": "#/$defs/positiveInt53" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": { "const": "chat" },
            "id": { "$ref": "#/$defs/int53Nonzero" }
          }
        }
      ]
    },
    "scheduledMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chat_id", "date", "sender", "is_outgoing", "topic", "type", "text", "scheduled"],
      "properties": {
        "id": { "$ref": "#/$defs/int53Nonzero" },
        "chat_id": { "$ref": "#/$defs/int53Nonzero" },
        "date": { "type": "null" },
        "sender": { "$ref": "#/$defs/sender" },
        "is_outgoing": { "type": "boolean" },
        "topic": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/topic" }
          ]
        },
        "type": { "enum": ["text", "photo", "video", "doc", "voice", "other"] },
        "text": { "type": "string" },
        "scheduled": { "const": true }
      }
    },
    "deliveredMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chat_id", "date", "sender", "is_outgoing", "topic", "type", "text", "scheduled"],
      "properties": {
        "id": { "$ref": "#/$defs/int53Nonzero" },
        "chat_id": { "$ref": "#/$defs/int53Nonzero" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "sender": { "$ref": "#/$defs/sender" },
        "is_outgoing": { "type": "boolean" },
        "topic": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/topic" }
          ]
        },
        "type": { "enum": ["text", "photo", "video", "doc", "voice", "other"] },
        "text": { "type": "string" },
        "scheduled": { "const": false }
      }
    },
    "chatIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "is_bot", "usernames"],
      "properties": {
        "id": { "$ref": "#/$defs/int53Nonzero" },
        "title": { "type": "string" },
        "type": { "enum": ["private", "basic_group", "supergroup", "channel"] },
        "is_bot": { "type": "boolean" },
        "usernames": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,32}$" }
        }
      }
    },
    "forumTopic": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "forum" },
            "id": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
          }
        }
      ]
    },
    "schedule": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "online" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "send_date"],
          "properties": {
            "kind": { "const": "at" },
            "send_date": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
          }
        }
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "account", "tdlib_request", "chat", "text", "parse_mode", "reply_to", "requested_topic", "effective_topic", "silent", "schedule", "observed_server_unix_time"],
      "properties": {
        "operation": { "const": "send" },
        "account": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
        "tdlib_request": { "const": "sendMessage" },
        "chat": { "$ref": "#/$defs/chatIdentity" },
        "text": { "type": "string", "minLength": 1 },
        "parse_mode": { "enum": ["plain", "markdown_v2", "html"] },
        "reply_to": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/int53Nonzero" }
          ]
        },
        "requested_topic": { "$ref": "#/$defs/forumTopic" },
        "effective_topic": { "$ref": "#/$defs/forumTopic" },
        "silent": { "type": "boolean" },
        "schedule": { "$ref": "#/$defs/schedule" },
        "observed_server_unix_time": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer" }
          ]
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/scheduledMessage" },
    { "$ref": "#/$defs/deliveredMessage" },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["dry_run", "plan"],
      "properties": {
        "dry_run": { "const": true },
        "plan": { "$ref": "#/$defs/plan" }
      }
    }
  ]
}
