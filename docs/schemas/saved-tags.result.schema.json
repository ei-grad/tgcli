{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "next"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "label", "count"],
        "properties": {
          "tag": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "next": { "type": "null" }
  }
}
