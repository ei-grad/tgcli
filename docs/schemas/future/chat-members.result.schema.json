{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tgcli chat members result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items",
    "next"
  ],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 0,
      "maxItems": 200,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sender",
              "is_bot",
              "display_name",
              "usernames",
              "status",
              "tag",
              "joined_at"
            ],
            "properties": {
              "sender": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "id"
                ],
                "properties": {
                  "type": {
                    "const": "user"
                  },
                  "id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                }
              },
              "is_bot": {
                "type": "boolean"
              },
              "display_name": {
                "type": "string"
              },
              "usernames": {
                "type": "array",
                "minItems": 0,
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "status": {
                "enum": [
                  "creator",
                  "administrator",
                  "member",
                  "restricted",
                  "left",
                  "banned"
                ]
              },
              "tag": {
                "type": "string"
              },
              "joined_at": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sender",
              "is_bot",
              "display_name",
              "usernames",
              "status",
              "tag",
              "joined_at"
            ],
            "properties": {
              "sender": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "id"
                ],
                "properties": {
                  "type": {
                    "const": "chat"
                  },
                  "id": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991,
                    "not": {
                      "const": 0
                    }
                  }
                }
              },
              "is_bot": {
                "const": false
              },
              "display_name": {
                "type": "string"
              },
              "usernames": {
                "type": "array",
                "minItems": 0,
                "maxItems": 100,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "status": {
                "enum": [
                  "creator",
                  "administrator",
                  "member",
                  "restricted",
                  "left",
                  "banned"
                ]
              },
              "tag": {
                "type": "string"
              },
              "joined_at": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "next": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    }
  }
}
