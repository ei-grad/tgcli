{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tgcli msg forward result",
  "$defs": {
    "int53": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "not": { "const": 0 }
    },
    "positiveInt53": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/int53" }
    },
    "sender": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": { "const": "user" },
            "id": { "$ref": "#/$defs/positiveInt53" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": { "const": "chat" },
            "id": { "$ref": "#/$defs/int53" }
          }
        }
      ]
    },
    "topic": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "forum" },
            "id": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["thread", "direct", "saved"] },
            "id": { "$ref": "#/$defs/positiveInt53" }
          }
        }
      ]
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chat_id", "date", "sender", "is_outgoing", "topic", "type", "text", "scheduled"],
      "properties": {
        "id": { "$ref": "#/$defs/int53" },
        "chat_id": { "$ref": "#/$defs/int53" },
        "date": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
          ]
        },
        "sender": { "$ref": "#/$defs/sender" },
        "is_outgoing": { "type": "boolean" },
        "topic": { "$ref": "#/$defs/topic" },
        "type": { "enum": ["text", "photo", "video", "doc", "voice", "other"] },
        "text": { "type": "string" },
        "scheduled": { "type": "boolean" }
      },
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "chat_id", "date", "sender", "is_outgoing", "topic", "type", "text", "scheduled"],
          "properties": {
            "id": { "$ref": "#/$defs/int53" },
            "chat_id": { "$ref": "#/$defs/int53" },
            "scheduled": { "const": true },
            "date": { "type": "null" },
            "sender": { "$ref": "#/$defs/sender" },
            "is_outgoing": { "type": "boolean" },
            "topic": { "$ref": "#/$defs/topic" },
            "type": { "enum": ["text", "photo", "video", "doc", "voice", "other"] },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "chat_id", "date", "sender", "is_outgoing", "topic", "type", "text", "scheduled"],
          "properties": {
            "id": { "$ref": "#/$defs/int53" },
            "chat_id": { "$ref": "#/$defs/int53" },
            "scheduled": { "const": false },
            "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
            "sender": { "$ref": "#/$defs/sender" },
            "is_outgoing": { "type": "boolean" },
            "topic": { "$ref": "#/$defs/topic" },
            "type": { "enum": ["text", "photo", "video", "doc", "voice", "other"] },
            "text": { "type": "string" }
          }
        }
      ]
    },
    "sentItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "status", "message"],
      "properties": {
        "source_id": { "$ref": "#/$defs/int53" },
        "status": { "const": "sent" },
        "message": { "$ref": "#/$defs/message" }
      }
    },
    "chatIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "is_bot", "usernames"],
      "properties": {
        "id": { "$ref": "#/$defs/int53" },
        "title": { "type": "string" },
        "type": { "enum": ["private", "basic_group", "supergroup", "channel"] },
        "is_bot": { "type": "boolean" },
        "usernames": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,32}$" }
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "account", "tdlib_request", "from", "to", "message_ids", "drop_author"],
      "properties": {
        "operation": { "const": "msg_forward" },
        "account": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
        "tdlib_request": { "const": "forwardMessages" },
        "from": { "$ref": "#/$defs/chatIdentity" },
        "to": { "$ref": "#/$defs/chatIdentity" },
        "message_ids": { "$ref": "#/$defs/ids" },
        "drop_author": { "type": "boolean" }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_chat_id", "to_chat_id", "items"],
      "properties": {
        "from_chat_id": { "$ref": "#/$defs/int53" },
        "to_chat_id": { "$ref": "#/$defs/int53" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/sentItem" }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["dry_run", "plan"],
      "properties": {
        "dry_run": { "const": true },
        "plan": { "$ref": "#/$defs/plan" }
      }
    }
  ]
}
