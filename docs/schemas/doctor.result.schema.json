{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tgcli doctor result",
  "oneOf": [
    {
      "title": "reachable daemon",
      "type": "object",
      "additionalProperties": false,
      "required": ["account", "daemon", "tdlib", "auth"],
      "properties": {
        "account": {
          "type": "string"
        },
        "daemon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["running", "in_process", "pid", "version", "socket"],
          "properties": {
            "running": {
              "const": true
            },
            "in_process": {
              "const": false
            },
            "pid": {
              "type": "integer",
              "minimum": 1
            },
            "version": {
              "type": "string"
            },
            "socket": {
              "type": "string"
            }
          }
        },
        "tdlib": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version"],
          "properties": {
            "version": {
              "type": "string"
            }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": {
              "enum": ["unknown", "wait_tdlib_parameters", "wait_phone_number", "wait_premium_purchase", "wait_email_address", "wait_email_code", "wait_code", "wait_other_device_confirmation", "wait_registration", "wait_password", "ready", "logging_out", "closing", "closed"]
            }
          }
        }
      }
    },
    {
      "title": "in-process daemon bypass",
      "type": "object",
      "additionalProperties": false,
      "required": ["account", "daemon", "tdlib", "auth"],
      "properties": {
        "account": {
          "type": "string"
        },
        "daemon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["running", "in_process", "pid", "version"],
          "properties": {
            "running": {
              "const": false
            },
            "in_process": {
              "const": true
            },
            "pid": {
              "type": "integer",
              "minimum": 1
            },
            "version": {
              "type": "string"
            }
          }
        },
        "tdlib": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version"],
          "properties": {
            "version": {
              "type": "string"
            }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": {
              "enum": ["unknown", "wait_tdlib_parameters", "wait_phone_number", "wait_premium_purchase", "wait_email_address", "wait_email_code", "wait_code", "wait_other_device_confirmation", "wait_registration", "wait_password", "ready", "logging_out", "closing", "closed"]
            }
          }
        }
      }
    },
    {
      "title": "local fallback",
      "type": "object",
      "additionalProperties": false,
      "required": ["account", "daemon", "config"],
      "properties": {
        "account": {
          "type": "string"
        },
        "daemon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["running", "socket"],
          "properties": {
            "running": {
              "const": false
            },
            "socket": {
              "type": "string"
            }
          }
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "exists"],
          "properties": {
            "path": {
              "type": "string"
            },
            "exists": {
              "type": "boolean"
            }
          }
        }
      }
    }
  ]
}
