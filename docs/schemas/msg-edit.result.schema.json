{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tgcli msg edit result",
  "$defs": {
    "int53": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "not": { "const": 0 }
    },
    "positiveInt53": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "sender": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": { "type": { "const": "user" }, "id": { "$ref": "#/$defs/positiveInt53" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": { "type": { "const": "chat" }, "id": { "$ref": "#/$defs/int53" } }
        }
      ]
    },
    "topic": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "forum" },
            "id": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["thread", "direct", "saved"] },
            "id": { "$ref": "#/$defs/positiveInt53" }
          }
        }
      ]
    },
    "chatIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "is_bot", "usernames"],
      "properties": {
        "id": { "$ref": "#/$defs/int53" },
        "title": { "type": "string" },
        "type": { "enum": ["private", "basic_group", "supergroup", "channel"] },
        "is_bot": { "type": "boolean" },
        "usernames": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,32}$" }
        }
      }
    },
    "scheduledMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chat_id", "date", "sender", "is_outgoing", "topic", "type", "text", "scheduled"],
      "properties": {
        "id": { "$ref": "#/$defs/int53" },
        "chat_id": { "$ref": "#/$defs/int53" },
        "date": { "type": "null" },
        "sender": { "$ref": "#/$defs/sender" },
        "is_outgoing": { "type": "boolean" },
        "topic": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/topic" }] },
        "type": { "const": "text" },
        "text": { "type": "string" },
        "scheduled": { "const": true }
      }
    },
    "deliveredMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chat_id", "date", "sender", "is_outgoing", "topic", "type", "text", "scheduled"],
      "properties": {
        "id": { "$ref": "#/$defs/int53" },
        "chat_id": { "$ref": "#/$defs/int53" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "sender": { "$ref": "#/$defs/sender" },
        "is_outgoing": { "type": "boolean" },
        "topic": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/topic" }] },
        "type": { "const": "text" },
        "text": { "type": "string" },
        "scheduled": { "const": false }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "account", "tdlib_request", "chat", "message_id", "text"],
      "properties": {
        "operation": { "const": "msg_edit" },
        "account": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
        "tdlib_request": { "const": "editMessageText" },
        "chat": { "$ref": "#/$defs/chatIdentity" },
        "message_id": { "$ref": "#/$defs/int53" },
        "text": { "type": "string", "minLength": 1 }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/scheduledMessage" },
    { "$ref": "#/$defs/deliveredMessage" },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["dry_run", "plan"],
      "properties": { "dry_run": { "const": true }, "plan": { "$ref": "#/$defs/plan" } }
    }
  ]
}
