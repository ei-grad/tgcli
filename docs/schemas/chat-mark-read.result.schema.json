{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tgcli chat mark-read result",
  "$defs": {
    "int53": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991, "not": { "const": 0 } },
    "chat": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "type", "is_bot", "usernames"],
      "properties": {
        "id": { "$ref": "#/$defs/int53" }, "title": { "type": "string" },
        "type": { "enum": ["private", "basic_group", "supergroup", "channel"] },
        "is_bot": { "type": "boolean" },
        "usernames": { "type": "array", "maxItems": 100, "items": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,32}$" } }
      }
    },
    "plan": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["operation", "account", "tdlib_request", "chat", "last_message_id"],
          "properties": {
            "operation": { "const": "chat_mark_read" }, "account": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
            "tdlib_request": { "const": null }, "chat": { "$ref": "#/$defs/chat" }, "last_message_id": { "const": null }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["operation", "account", "tdlib_request", "chat", "last_message_id"],
          "properties": {
            "operation": { "const": "chat_mark_read" }, "account": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
            "tdlib_request": { "const": "viewMessages" }, "chat": { "$ref": "#/$defs/chat" }, "last_message_id": { "$ref": "#/$defs/int53" }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["chat_id", "last_read_message_id", "marked_read"],
      "properties": { "chat_id": { "$ref": "#/$defs/int53" }, "last_read_message_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/int53" }] }, "marked_read": { "const": true } }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["dry_run", "plan"],
      "properties": { "dry_run": { "const": true }, "plan": { "$ref": "#/$defs/plan" } }
    }
  ]
}
