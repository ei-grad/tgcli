{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tgcli saved attach result",
  "$defs": {
    "int53": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "not": { "const": 0 }
    },
    "positiveInt53": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "uint64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "int64": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "sender": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": { "const": "user" },
            "id": { "$ref": "#/$defs/positiveInt53" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": { "const": "chat" },
            "id": { "$ref": "#/$defs/int53" }
          }
        }
      ]
    },
    "savedTopic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "const": "saved" },
        "id": { "$ref": "#/$defs/positiveInt53" }
      }
    },
    "chatIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "is_bot", "usernames"],
      "properties": {
        "id": { "$ref": "#/$defs/int53" },
        "title": { "type": "string" },
        "type": { "const": "private" },
        "is_bot": { "const": false },
        "usernames": {
          "type": "array",
          "maxItems": 100,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,32}$" }
        }
      }
    },
    "fileSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "name", "size", "sha256", "device", "inode", "mtime_ns", "ctime_ns"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^/(?!\\.{1,2}(?:/|$))[^/\\x00]+(?:/(?!\\.{1,2}(?:/|$))[^/\\x00]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?!\\.{1,2}$)(?!.*(?:\\u0000|\\u0001|\\u0002|\\u0003|\\u0004|\\u0005|\\u0006|\\u0007|\\u0008|\\u0009|\\u000a|\\u000b|\\u000c|\\u000d|\\u000e|\\u000f|\\u0010|\\u0011|\\u0012|\\u0013|\\u0014|\\u0015|\\u0016|\\u0017|\\u0018|\\u0019|\\u001a|\\u001b|\\u001c|\\u001d|\\u001e|\\u001f|\\u007f|\\u0080|\\u0081|\\u0082|\\u0083|\\u0084|\\u0085|\\u0086|\\u0087|\\u0088|\\u0089|\\u008a|\\u008b|\\u008c|\\u008d|\\u008e|\\u008f|\\u0090|\\u0091|\\u0092|\\u0093|\\u0094|\\u0095|\\u0096|\\u0097|\\u0098|\\u0099|\\u009a|\\u009b|\\u009c|\\u009d|\\u009e|\\u009f))[^/]+$"
        },
        "size": { "$ref": "#/$defs/uint64" },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "device": { "$ref": "#/$defs/uint64" },
        "inode": { "$ref": "#/$defs/uint64" },
        "mtime_ns": { "$ref": "#/$defs/int64" },
        "ctime_ns": { "$ref": "#/$defs/int64" }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chat_id", "date", "sender", "is_outgoing", "topic", "type", "text", "scheduled"],
      "properties": {
        "id": { "$ref": "#/$defs/int53" },
        "chat_id": { "$ref": "#/$defs/int53" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "sender": { "$ref": "#/$defs/sender" },
        "is_outgoing": { "type": "boolean" },
        "topic": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/savedTopic" }
          ]
        },
        "type": { "const": "doc" },
        "text": { "type": "string", "maxLength": 1024, "pattern": "^[^\\u0000]*$" },
        "scheduled": { "const": false }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "account", "tdlib_request", "chat", "message_id", "effective_topic", "caption", "file"],
      "properties": {
        "operation": { "const": "saved_attach" },
        "account": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
        "tdlib_request": { "const": "sendMessage" },
        "chat": { "$ref": "#/$defs/chatIdentity" },
        "message_id": { "$ref": "#/$defs/int53" },
        "effective_topic": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/savedTopic" }
          ]
        },
        "caption": { "type": "string", "maxLength": 1024, "pattern": "^[^\\u0000]*$" },
        "file": { "$ref": "#/$defs/fileSnapshot" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/message" },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["dry_run", "plan"],
      "properties": {
        "dry_run": { "const": true },
        "plan": { "$ref": "#/$defs/plan" }
      }
    }
  ]
}
