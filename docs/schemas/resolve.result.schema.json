{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "int53_nonzero": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "not": { "const": 0 }
    },
    "chat_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "is_bot", "usernames"],
      "properties": {
        "id": { "$ref": "#/$defs/int53_nonzero" },
        "title": { "type": "string" },
        "type": { "enum": ["private", "basic_group", "supergroup", "channel"] },
        "is_bot": { "type": "boolean" },
        "usernames": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "topic": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "forum" },
            "id": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "thread" },
            "id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "direct" },
            "id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "saved" },
            "id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "chat", "message_id", "topic", "link_type", "is_public"],
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "message" },
        "chat": {},
        "message_id": { "$ref": "#/$defs/int53_nonzero" },
        "topic": {},
        "link_type": {},
        "is_public": {}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "topic" },
        "chat": {},
        "message_id": { "type": "null" },
        "topic": { "$ref": "#/$defs/topic" },
        "link_type": {},
        "is_public": {}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "chat" },
        "chat": {},
        "message_id": { "type": "null" },
        "topic": { "type": "null" },
        "link_type": {},
        "is_public": {}
      }
    }
  ],
  "properties": {
    "kind": { "enum": ["chat", "message", "topic"] },
    "chat": { "$ref": "#/$defs/chat_identity" },
    "message_id": {
      "oneOf": [
        { "$ref": "#/$defs/int53_nonzero" },
        { "type": "null" }
      ]
    },
    "topic": {
      "oneOf": [
        { "$ref": "#/$defs/topic" },
        { "type": "null" }
      ]
    },
    "link_type": {
      "oneOf": [
        {
          "enum": [
            "public_chat",
            "bot_start",
            "message",
            "chat_invite",
            "direct_messages_chat",
            "saved_messages"
          ]
        },
        { "type": "null" }
      ]
    },
    "is_public": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "null" }
      ]
    }
  }
}
