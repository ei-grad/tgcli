{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tgcli account command error",
  "$defs": {
    "account": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,32}$"
    },
    "state": {
      "enum": ["unknown", "wait_tdlib_parameters", "wait_phone_number", "wait_email_address", "wait_email_code", "wait_code", "wait_registration", "wait_password", "wait_other_device_confirmation", "wait_premium_purchase", "ready", "logging_out", "closing", "closed"]
    },
    "accountRemoveStage": {
      "enum": ["planned", "intent_synced", "remote_logout_send_started", "remote_confirmed", "remote_not_present", "remote_kept", "client_close_started", "client_closed", "config_remove_started", "config_removed", "data_remove_started", "data_removed", "state_remove_started", "state_removed"]
    },
    "rootIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "device", "inode", "owner"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "device": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "inode": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "owner": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 }
      }
    },
    "remoteLogoutPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "account", "remote_logout", "keep_session", "delete_paths", "config_path", "config_snapshot", "data_root", "state_root", "reassign_default"],
      "properties": {
        "operation": { "const": "account_remove" },
        "account": { "$ref": "#/$defs/account" },
        "remote_logout": { "const": true },
        "keep_session": { "const": false },
        "delete_paths": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string", "pattern": "^/" }
        },
        "config_path": { "type": "string", "pattern": "^/" },
        "config_snapshot": { "type": "string" },
        "data_root": {
          "oneOf": [
            { "$ref": "#/$defs/rootIdentity" },
            { "type": "null" }
          ]
        },
        "state_root": {
          "oneOf": [
            { "$ref": "#/$defs/rootIdentity" },
            { "type": "null" }
          ]
        },
        "reassign_default": {
          "oneOf": [
            { "$ref": "#/$defs/account" },
            { "type": "null" }
          ]
        }
      }
    },
    "keepSessionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "account", "remote_logout", "keep_session", "delete_paths", "config_path", "config_snapshot", "data_root", "state_root", "reassign_default"],
      "properties": {
        "operation": { "const": "account_remove" },
        "account": { "$ref": "#/$defs/account" },
        "remote_logout": { "const": false },
        "keep_session": { "const": true },
        "delete_paths": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string", "pattern": "^/" }
        },
        "config_path": { "type": "string", "pattern": "^/" },
        "config_snapshot": { "type": "string" },
        "data_root": {
          "oneOf": [
            { "$ref": "#/$defs/rootIdentity" },
            { "type": "null" }
          ]
        },
        "state_root": {
          "oneOf": [
            { "$ref": "#/$defs/rootIdentity" },
            { "type": "null" }
          ]
        },
        "reassign_default": {
          "oneOf": [
            { "$ref": "#/$defs/account" },
            { "type": "null" }
          ]
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "USAGE" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["argument", "reason"],
              "properties": {
                "argument": { "type": ["string", "null"] },
                "reason": {
                  "enum": ["missing_argument", "invalid_argument", "mutually_exclusive", "unknown_command", "invalid_environment", "unsupported_mode"]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "ACCOUNT_EXISTS" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["account"],
              "properties": { "account": { "type": "string" } }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "ACCOUNT_NOT_FOUND" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["account"],
              "properties": { "account": { "type": "string" } }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "DEFAULT_REASSIGNMENT_REQUIRED" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["account", "candidates"],
              "properties": {
                "account": { "$ref": "#/$defs/account" },
                "candidates": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/account" }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "ACCOUNT_MISMATCH" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requested_account", "daemon_account"],
              "properties": {
                "requested_account": { "$ref": "#/$defs/account" },
                "daemon_account": { "$ref": "#/$defs/account" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "CONFIG_INVALID" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "reason"],
              "properties": {
                "path": { "type": "string", "pattern": "^/" },
                "reason": {
                  "enum": ["path_invalid", "wrong_owner", "wrong_type", "wrong_mode", "wrong_link_count", "too_large", "parse_error", "type_error", "invalid_default", "conflicting_credentials", "io_error", "sync_error"]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "CONFIG_CONFLICT" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "expected", "current"],
              "properties": {
                "path": { "type": "string", "pattern": "^/" },
                "expected": { "type": "string" },
                "current": { "type": "string" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "WRITE_DENIED" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["account", "reason"],
              "properties": {
                "account": { "$ref": "#/$defs/account" },
                "reason": { "enum": ["explicit_deny", "no_grant", "invalid_config_grant"] }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "CONFIRMATION_REQUIRED" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["account", "action", "target"],
              "properties": {
                "account": { "$ref": "#/$defs/account" },
                "action": { "const": "account_remove" },
                "target": {
                  "oneOf": [
                    { "$ref": "#/$defs/remoteLogoutPlan" },
                    { "$ref": "#/$defs/keepSessionPlan" }
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "AUDIT_UNAVAILABLE" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["account", "path", "reason"],
              "properties": {
                "account": { "$ref": "#/$defs/account" },
                "path": { "type": "string", "pattern": "^/" },
                "reason": { "enum": ["path_invalid", "open_failed", "write_failed", "sync_failed", "rotate_failed"] }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "REMOTE_LOGOUT_UNCONFIRMED" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["account", "state", "reason"],
              "properties": {
                "account": { "$ref": "#/$defs/account" },
                "state": { "$ref": "#/$defs/state" },
                "reason": { "enum": ["tdlib_error", "timeout", "generation_lost", "transport_lost", "state_unproven"] }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "LOCAL_CLEANUP_FAILED" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["account", "reason", "removed", "retained"],
              "properties": {
                "account": { "$ref": "#/$defs/account" },
                "reason": { "enum": ["path_changed", "path_invalid", "mount_boundary", "io_error", "sync_error"] },
                "removed": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^/" }
                },
                "retained": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^/" }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "REMOVAL_INCOMPLETE" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["account", "path", "invocation_id", "stage", "completed_stages", "reason"],
              "properties": {
                "account": { "$ref": "#/$defs/account" },
                "path": { "type": "string", "pattern": "^/" },
                "invocation_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
                "stage": { "$ref": "#/$defs/accountRemoveStage" },
                "completed_stages": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/accountRemoveStage" }
                },
                "reason": { "enum": ["prior_crash", "identity_ambiguous", "outcome_missing"] }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "RATE_LIMITED" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "tdlib_code", "retry_after"],
              "properties": {
                "operation": { "const": "account_remove" },
                "tdlib_code": { "const": 429 },
                "retry_after": { "type": "integer" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "TDLIB_ERROR" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "tdlib_code"],
              "properties": {
                "operation": { "const": "account_remove" },
                "tdlib_code": { "type": "integer" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "DAEMON_SHUTDOWN" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reason"],
              "properties": {
                "reason": { "const": "daemon_shutdown" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "TIMEOUT" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "state"],
              "properties": {
                "operation": { "enum": ["account_add", "account_list", "account_show", "account_use", "account_remove"] },
                "state": {
                  "oneOf": [
                    { "$ref": "#/$defs/state" },
                    { "type": "null" }
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "INTERNAL" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "reason"],
              "properties": {
                "operation": { "enum": ["account_add", "account_list", "account_show", "account_use", "account_remove"] },
                "reason": { "const": "internal_error" }
              }
            }
          }
        }
      ]
    }
  }
}
