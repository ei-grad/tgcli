{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "state": {
      "enum": [
        "unknown",
        "wait_tdlib_parameters",
        "wait_phone_number",
        "wait_premium_purchase",
        "wait_email_address",
        "wait_email_code",
        "wait_code",
        "wait_other_device_confirmation",
        "wait_registration",
        "wait_password",
        "ready",
        "logging_out",
        "closing",
        "closed"
      ]
    },
    "chat_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "is_bot", "usernames"],
      "properties": {
        "id": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991, "not": { "const": 0 } },
        "title": { "type": "string" },
        "type": { "enum": ["private", "basic_group", "supergroup", "channel"] },
        "is_bot": { "type": "boolean" },
        "usernames": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "USAGE" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["argument", "reason"],
              "properties": {
                "argument": { "type": ["string", "null"] },
                "reason": { "enum": ["missing_argument", "invalid_argument", "mutually_exclusive", "unknown_command", "unsupported_mode", "unsupported_chat_type", "unsupported_link_type"] }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "NOT_AUTHED" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["account", "state", "reason"],
              "properties": {
                "account": { "type": "string" },
                "state": { "$ref": "#/$defs/state" },
                "reason": { "enum": ["not_ready", "authorization_lost"] }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "BOT_UNSUPPORTED" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation"],
              "properties": { "operation": { "const": "resolve" } }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "NOT_FOUND" },
            "message": { "type": "string" },
            "details": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["selector"],
                  "properties": { "selector": { "type": "string" } }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["selector", "scope"],
                  "properties": {
                    "selector": { "type": "string" },
                    "scope": { "const": "local_materialized" }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "AMBIGUOUS" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["selector", "scope", "candidates", "truncated"],
              "properties": {
                "selector": { "type": "string" },
                "scope": { "enum": ["active_dialogs", "local_materialized"] },
                "candidates": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/chat_identity" } },
                "truncated": { "type": "boolean" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "RATE_LIMITED" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "tdlib_code", "retry_after"],
              "properties": {
                "operation": { "const": "resolve" },
                "tdlib_code": { "const": 429 },
                "retry_after": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "TDLIB_ERROR" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "tdlib_code"],
              "properties": {
                "operation": { "const": "resolve" },
                "tdlib_code": { "type": "integer" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "TIMEOUT" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "state"],
              "properties": {
                "operation": { "const": "resolve" },
                "state": { "oneOf": [{ "$ref": "#/$defs/state" }, { "type": "null" }] }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": { "const": "INTERNAL" },
            "message": { "type": "string" },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "reason"],
              "properties": {
                "operation": { "const": "resolve" },
                "reason": { "const": "internal_error" }
              }
            }
          }
        }
      ]
    }
  }
}
