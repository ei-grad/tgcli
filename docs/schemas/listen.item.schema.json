{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tgcli listen item",
  "$defs": {
    "int53": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "not": { "const": 0 }
    },
    "nonnegativeInt53": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveInt53": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "string",
      "not": { "const": "1970-01-01T00:00:00Z" },
      "oneOf": [
        {
          "pattern": "^(?:19(?:7[0-9]|8[0-9]|9[0-9])|20(?:0[0-9]|1[0-9]|2[0-9]|3[0-7]))-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12][0-9]|3[01])|(?:0[469]|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        },
        {
          "pattern": "^(?:19(?:7[26]|8[048]|9[26])|20(?:0[048]|1[26]|2[048]|3[26]))-02-29T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        },
        {
          "pattern": "^(?:2038-01-(?:0[1-9]|1[0-8])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]|2038-01-19T(?:0[0-2]:[0-5][0-9]:[0-5][0-9]|03:(?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:0[0-7])))Z$"
        }
      ]
    },
    "timestampOrNull": {
      "oneOf": [
        { "$ref": "#/$defs/timestamp" },
        { "type": "null" }
      ]
    },
    "sender": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": { "const": "user" },
            "id": { "$ref": "#/$defs/positiveInt53" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": { "const": "chat" },
            "id": { "$ref": "#/$defs/int53" }
          }
        }
      ]
    },
    "topic": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "forum" },
            "id": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["thread", "direct", "saved"] },
            "id": { "$ref": "#/$defs/positiveInt53" }
          }
        }
      ]
    },
    "messageSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "chat_id",
        "date",
        "sender",
        "is_outgoing",
        "topic",
        "type",
        "text"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/int53" },
        "chat_id": { "$ref": "#/$defs/int53" },
        "date": { "$ref": "#/$defs/timestampOrNull" },
        "sender": { "$ref": "#/$defs/sender" },
        "is_outgoing": { "type": "boolean" },
        "topic": {
          "oneOf": [
            { "$ref": "#/$defs/topic" },
            { "type": "null" }
          ]
        },
        "type": { "enum": ["text", "photo", "video", "doc", "voice", "other"] },
        "text": { "type": "string" }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "enum": ["text", "photo", "video", "doc", "voice", "other"] },
        "text": { "type": "string" }
      }
    },
    "chatIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "is_bot", "usernames"],
      "properties": {
        "id": { "$ref": "#/$defs/int53" },
        "title": { "type": "string" },
        "type": { "enum": ["private", "basic_group", "supergroup", "channel"] },
        "is_bot": { "type": "boolean" },
        "usernames": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "chatSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "type",
        "is_bot",
        "usernames",
        "is_archived",
        "folder_ids",
        "is_marked_unread",
        "unread_count",
        "unread_mention_count",
        "unread_reaction_count",
        "unread_poll_vote_count",
        "last_message"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/int53" },
        "title": { "type": "string" },
        "type": { "enum": ["private", "basic_group", "supergroup", "channel"] },
        "is_bot": { "type": "boolean" },
        "usernames": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "is_archived": { "type": "boolean" },
        "folder_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
        },
        "is_marked_unread": { "type": "boolean" },
        "unread_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "unread_mention_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "unread_reaction_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "unread_poll_vote_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "last_message": {
          "oneOf": [
            { "$ref": "#/$defs/messageSummary" },
            { "type": "null" }
          ]
        }
      }
    },
    "reaction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "emoji"],
          "properties": {
            "type": { "const": "emoji" },
            "emoji": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "custom_emoji_id"],
          "properties": {
            "type": { "const": "custom" },
            "custom_emoji_id": {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[01][0-9]{17}|92[01][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[01][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "paid" }
          }
        }
      ]
    },
    "reactionSnapshotItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reaction", "total_count", "is_chosen", "used_sender", "recent_senders"],
      "properties": {
        "reaction": { "$ref": "#/$defs/reaction" },
        "total_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "is_chosen": { "type": "boolean" },
        "used_sender": {
          "oneOf": [
            { "$ref": "#/$defs/sender" },
            { "type": "null" }
          ]
        },
        "recent_senders": {
          "type": "array",
          "items": { "$ref": "#/$defs/sender" }
        }
      }
    },
    "reactions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "are_tags", "can_get_added_reactions"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/reactionSnapshotItem" }
        },
        "are_tags": { "type": "boolean" },
        "can_get_added_reactions": { "type": "boolean" }
      }
    },
    "anonymousReaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reaction", "total_count"],
      "properties": {
        "reaction": { "$ref": "#/$defs/reaction" },
        "total_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "chatList": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "main" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "archive" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "folder_id"],
          "properties": {
            "type": { "const": "folder" },
            "folder_id": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
          }
        }
      ]
    },
    "messageEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "message"],
      "properties": {
        "event": { "const": "message" },
        "message": { "$ref": "#/$defs/messageSummary" }
      }
    },
    "editContentEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "chat_id", "message_id", "content"],
      "properties": {
        "event": { "const": "edit_content" },
        "chat_id": { "$ref": "#/$defs/int53" },
        "message_id": { "$ref": "#/$defs/int53" },
        "content": { "$ref": "#/$defs/content" }
      }
    },
    "editMetadataEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "chat_id", "message_id", "edit_date", "has_reply_markup"],
      "properties": {
        "event": { "const": "edit_metadata" },
        "chat_id": { "$ref": "#/$defs/int53" },
        "message_id": { "$ref": "#/$defs/int53" },
        "edit_date": { "$ref": "#/$defs/timestampOrNull" },
        "has_reply_markup": { "type": "boolean" }
      }
    },
    "reactionSnapshotEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "chat_id", "message_id", "reactions"],
      "properties": {
        "event": { "const": "reaction_snapshot" },
        "chat_id": { "$ref": "#/$defs/int53" },
        "message_id": { "$ref": "#/$defs/int53" },
        "reactions": {
          "oneOf": [
            { "$ref": "#/$defs/reactions" },
            { "type": "null" }
          ]
        }
      }
    },
    "botReactionChangeEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "chat_id",
        "message_id",
        "actor",
        "date",
        "old_reactions",
        "new_reactions"
      ],
      "properties": {
        "event": { "const": "bot_reaction_change" },
        "chat_id": { "$ref": "#/$defs/int53" },
        "message_id": { "$ref": "#/$defs/int53" },
        "actor": { "$ref": "#/$defs/sender" },
        "date": { "$ref": "#/$defs/timestamp" },
        "old_reactions": {
          "type": "array",
          "items": { "$ref": "#/$defs/reaction" }
        },
        "new_reactions": {
          "type": "array",
          "items": { "$ref": "#/$defs/reaction" }
        }
      }
    },
    "botReactionSnapshotEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "chat_id", "message_id", "date", "reactions"],
      "properties": {
        "event": { "const": "bot_reaction_snapshot" },
        "chat_id": { "$ref": "#/$defs/int53" },
        "message_id": { "$ref": "#/$defs/int53" },
        "date": { "$ref": "#/$defs/timestamp" },
        "reactions": {
          "type": "array",
          "items": { "$ref": "#/$defs/anonymousReaction" }
        }
      }
    },
    "deleteBatchEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "chat_id", "message_ids", "is_permanent", "from_cache"],
      "properties": {
        "event": { "const": "delete_batch" },
        "chat_id": { "$ref": "#/$defs/int53" },
        "message_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/int53" }
        },
        "is_permanent": { "type": "boolean" },
        "from_cache": { "type": "boolean" }
      }
    },
    "chatChangeEvent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event", "change", "chat"],
          "properties": {
            "event": { "const": "chat_change" },
            "change": { "const": "new" },
            "chat": { "$ref": "#/$defs/chatSummary" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event", "change", "chat"],
          "properties": {
            "event": { "const": "chat_change" },
            "change": { "const": "identity" },
            "chat": { "$ref": "#/$defs/chatIdentity" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event", "change", "chat_id", "title"],
          "properties": {
            "event": { "const": "chat_change" },
            "change": { "const": "title" },
            "chat_id": { "$ref": "#/$defs/int53" },
            "title": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event", "change", "chat_id", "last_message"],
          "properties": {
            "event": { "const": "chat_change" },
            "change": { "const": "last_message" },
            "chat_id": { "$ref": "#/$defs/int53" },
            "last_message": {
              "oneOf": [
                { "$ref": "#/$defs/messageSummary" },
                { "type": "null" }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event", "change", "chat_id", "list"],
          "properties": {
            "event": { "const": "chat_change" },
            "change": { "const": "list_added" },
            "chat_id": { "$ref": "#/$defs/int53" },
            "list": { "$ref": "#/$defs/chatList" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event", "change", "chat_id", "list"],
          "properties": {
            "event": { "const": "chat_change" },
            "change": { "const": "list_removed" },
            "chat_id": { "$ref": "#/$defs/int53" },
            "list": { "$ref": "#/$defs/chatList" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event",
            "change",
            "chat_id",
            "last_read_inbox_message_id",
            "unread_count"
          ],
          "properties": {
            "event": { "const": "chat_change" },
            "change": { "const": "read_inbox" },
            "chat_id": { "$ref": "#/$defs/int53" },
            "last_read_inbox_message_id": { "$ref": "#/$defs/nonnegativeInt53" },
            "unread_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event", "change", "chat_id", "unread_mention_count"],
          "properties": {
            "event": { "const": "chat_change" },
            "change": { "const": "unread_mention_count" },
            "chat_id": { "$ref": "#/$defs/int53" },
            "unread_mention_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event", "change", "chat_id", "unread_reaction_count"],
          "properties": {
            "event": { "const": "chat_change" },
            "change": { "const": "unread_reaction_count" },
            "chat_id": { "$ref": "#/$defs/int53" },
            "unread_reaction_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event", "change", "chat_id", "unread_poll_vote_count"],
          "properties": {
            "event": { "const": "chat_change" },
            "change": { "const": "unread_poll_vote_count" },
            "chat_id": { "$ref": "#/$defs/int53" },
            "unread_poll_vote_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event", "change", "chat_id", "is_marked_unread"],
          "properties": {
            "event": { "const": "chat_change" },
            "change": { "const": "marked_unread" },
            "chat_id": { "$ref": "#/$defs/int53" },
            "is_marked_unread": { "type": "boolean" }
          }
        }
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/messageEvent" },
    { "$ref": "#/$defs/editContentEvent" },
    { "$ref": "#/$defs/editMetadataEvent" },
    { "$ref": "#/$defs/reactionSnapshotEvent" },
    { "$ref": "#/$defs/botReactionChangeEvent" },
    { "$ref": "#/$defs/botReactionSnapshotEvent" },
    { "$ref": "#/$defs/deleteBatchEvent" },
    { "$ref": "#/$defs/chatChangeEvent" }
  ]
}
