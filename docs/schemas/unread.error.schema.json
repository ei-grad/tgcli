              "const": "NOT_AUTHED"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "account",
                "state",
                "reason"
              ],
              "properties": {
                "account": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,32}$"
