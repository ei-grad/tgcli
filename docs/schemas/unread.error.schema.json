                "state": {
                  "enum": [
                    "unknown",
                    "wait_tdlib_parameters",
                    "wait_phone_number",
                    "wait_premium_purchase",
                    "wait_email_address",
                    "wait_email_code",
                    "wait_code",
                    "wait_other_device_confirmation",
                    "wait_registration",
                    "wait_password",
                    "ready",
                    "logging_out",
                    "closing",
                    "closed"
                  ]
                },
                "reason": {
                  "enum": [
                    "not_ready",
                    "authorization_lost",
                    "login_required"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "details"
          ],
          "properties": {
            "code": {
              "const": "ACCOUNT_NOT_FOUND"
