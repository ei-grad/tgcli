              "type": "string"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "account"
              ],
              "properties": {
                "account": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,32}$"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "details"
          ],
          "properties": {
            "code": {
              "const": "ACCOUNT_MISMATCH"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requested_account",
                "daemon_account"
              ],
              "properties": {
                "requested_account": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,32}$"
                },
                "daemon_account": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,32}$"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "details"
