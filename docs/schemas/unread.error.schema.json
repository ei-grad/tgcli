{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tgcli unread error",
  "$defs": {
    "int53_nonzero": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "not": {
        "const": 0
      }
    },
    "positive_int53": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sender": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "const": "user"
            },
            "id": {
              "$ref": "#/$defs/positive_int53"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "id"
          ],
          "properties": {
            "type": {
              "const": "chat"
            },
            "id": {
              "$ref": "#/$defs/int53_nonzero"
            }
          }
        }
      ]
    },
    "topic": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "forum"
            },
            "id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "thread",
                "direct",
                "saved"
              ]
            },
            "id": {
              "$ref": "#/$defs/positive_int53"
            }
          }
        }
      ]
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "chat_id",
        "date",
        "sender",
        "is_outgoing",
        "topic",
        "type",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/int53_nonzero"
        },
        "chat_id": {
          "$ref": "#/$defs/int53_nonzero"
        },
        "date": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sender": {
          "$ref": "#/$defs/sender"
        },
        "is_outgoing": {
          "type": "boolean"
        },
        "topic": {
          "oneOf": [
            {
              "$ref": "#/$defs/topic"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "enum": [
            "text",
            "photo",
            "video",
            "doc",
            "voice",
            "other"
          ]
        },
        "text": {
          "type": "string"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "details"
          ],
          "properties": {
            "code": {
              "const": "USAGE"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "argument",
                "reason"
              ],
              "properties": {
                "argument": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "reason": {
                  "enum": [
                    "missing_argument",
                    "invalid_argument",
                    "unknown_command",
                    "unsupported_mode"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "details"
