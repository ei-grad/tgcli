              "properties": {
                "operation": {
                  "const": "unread"
                },
                "reason": {
                  "enum": [
                    "internal_error",
                    "malformed_tdlib_response"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "details"
          ],
          "properties": {
            "code": {
              "const": "DAEMON_SHUTDOWN"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason"
              ],
              "properties": {
                "reason": {
                  "const": "daemon_shutdown"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "details"
          ],
          "properties": {
            "code": {
              "const": "PROTOCOL_ANSWER_INVALID"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "request_id",
                "reason"
              ],
              "properties": {
                "request_id": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709552000
                },
                "reason": {
                  "enum": [
                    "future_sequence",
                    "nonce_mismatch",
                    "generation_mismatch",
                    "malformed",
                    "unknown_request"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "details"
          ],
          "properties": {
            "code": {
              "const": "TIMEOUT"
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "operation",
                "state"
              ],
              "properties": {
                "operation": {
                  "const": "unread"
                },
                "state": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "enum": [
                        "unknown",
                        "wait_tdlib_parameters",
                        "wait_phone_number",
                        "wait_premium_purchase",
                        "wait_email_address",
                        "wait_email_code",
                        "wait_code",
                        "wait_other_device_confirmation",
                        "wait_registration",
                        "wait_password",
                        "ready",
                        "logging_out",
                        "closing",
                        "closed"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
