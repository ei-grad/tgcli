{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "int53_nonzero": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "not": { "const": 0 }
    },
    "positive_int53": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sender": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": { "const": "user" },
            "id": { "$ref": "#/$defs/positive_int53" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": { "const": "chat" },
            "id": { "$ref": "#/$defs/int53_nonzero" }
          }
        }
      ]
    },
    "topic": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "forum" },
            "id": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["thread", "direct", "saved"] },
            "id": { "$ref": "#/$defs/positive_int53" }
          }
        }
      ]
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chat_id", "date", "sender", "is_outgoing", "topic", "type", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/int53_nonzero" },
        "chat_id": { "$ref": "#/$defs/int53_nonzero" },
        "date": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
            { "type": "null" }
          ]
        },
        "sender": { "$ref": "#/$defs/sender" },
        "is_outgoing": { "type": "boolean" },
        "topic": {
          "oneOf": [
            { "$ref": "#/$defs/topic" },
            { "type": "null" }
          ]
        },
        "type": { "enum": ["text", "photo", "video", "doc", "voice", "other"] },
        "text": { "type": "string" }
      }
    },
    "private_chat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "type",
        "is_bot",
        "usernames",
        "is_archived",
        "folder_ids",
        "is_marked_unread",
        "unread_count",
        "unread_mention_count",
        "unread_reaction_count",
        "unread_poll_vote_count",
        "last_message"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/int53_nonzero" },
        "title": { "type": "string" },
        "type": { "const": "private" },
        "is_bot": { "type": "boolean" },
        "usernames": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "is_archived": { "type": "boolean" },
        "folder_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
        },
        "is_marked_unread": { "type": "boolean" },
        "unread_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "unread_mention_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "unread_reaction_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "unread_poll_vote_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "last_message": {
          "oneOf": [
            { "$ref": "#/$defs/message" },
            { "type": "null" }
          ]
        }
      }
    },
    "non_private_chat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "type",
        "is_bot",
        "usernames",
        "is_archived",
        "folder_ids",
        "is_marked_unread",
        "unread_count",
        "unread_mention_count",
        "unread_reaction_count",
        "unread_poll_vote_count",
        "last_message"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/int53_nonzero" },
        "title": { "type": "string" },
        "type": { "enum": ["basic_group", "supergroup", "channel"] },
        "is_bot": { "const": false },
        "usernames": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "is_archived": { "type": "boolean" },
        "folder_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
        },
        "is_marked_unread": { "type": "boolean" },
        "unread_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "unread_mention_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "unread_reaction_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "unread_poll_vote_count": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "last_message": {
          "oneOf": [
            { "$ref": "#/$defs/message" },
            { "type": "null" }
          ]
        }
      }
    },
    "chat": {
      "oneOf": [
        { "$ref": "#/$defs/private_chat" },
        { "$ref": "#/$defs/non_private_chat" }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "next"],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/chat" }
    },
    "next": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    }
  }
}
