{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ei-grad/tgcli/release/dependencies.lock.schema.json",
  "title": "tgcli dependency source lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "archive_policy", "components"],
  "properties": {
    "$schema": {
      "const": "./dependencies.lock.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "archive_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "github_outer_compression"],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "github_outer_compression": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/lockedComponent" },
          { "$ref": "#/$defs/plannedComponent" }
        ]
      }
    }
  },
  "$defs": {
    "licenseFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^release/licenses/[A-Za-z0-9.+_-]+\\.txt$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "embeddedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "source_path",
        "license_expression",
        "license_files"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "license_expression": {
          "type": "string",
          "minLength": 1
        },
        "license_files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/licenseFile" }
        }
      }
    },
    "lockedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "scope",
        "lock_state",
        "integration",
        "source_repository",
        "source_archive",
        "immutable_ref",
        "version",
        "archive_sha256",
        "license_expression",
        "license_files",
        "embedded_components"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": ["runtime", "release-runtime", "test-only"]
        },
        "lock_state": {
          "const": "locked"
        },
        "integration": {
          "enum": [
            "fetchcontent",
            "fetchcontent-or-pinned-prefix",
            "release-toolchain-pending",
            "test-fetchcontent"
          ]
        },
        "source_repository": {
          "type": "string",
          "pattern": "^https://"
        },
        "source_archive": {
          "type": "string",
          "pattern": "^https://"
        },
        "immutable_ref": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "archive_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "license_expression": {
          "type": "string",
          "minLength": 1
        },
        "license_files": {
          "type": "array",
          "items": { "$ref": "#/$defs/licenseFile" }
        },
        "embedded_components": {
          "type": "array",
          "items": { "$ref": "#/$defs/embeddedComponent" }
        }
      }
    },
    "plannedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "scope",
        "lock_state",
        "integration",
        "source_repository",
        "source_archive",
        "immutable_ref",
        "version",
        "archive_sha256",
        "license_expression",
        "license_files",
        "embedded_components"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "const": "planned-runtime"
        },
        "lock_state": {
          "const": "unresolved"
        },
        "integration": {
          "const": "toolchain-unselected"
        },
        "source_repository": {
          "type": "string",
          "pattern": "^https://"
        },
        "source_archive": {
          "type": "null"
        },
        "immutable_ref": {
          "type": "null"
        },
        "version": {
          "type": "null"
        },
        "archive_sha256": {
          "type": "null"
        },
        "license_expression": {
          "type": "string",
          "minLength": 1
        },
        "license_files": {
          "type": "array",
          "maxItems": 0
        },
        "embedded_components": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  }
}
