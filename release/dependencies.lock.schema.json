{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ei-grad/tgcli/release/dependencies.lock.schema.json",
  "title": "tgcli dependency source lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "archive_policy",
    "release_toolchains",
    "components"
  ],
  "properties": {
    "$schema": {
      "const": "./dependencies.lock.schema.json"
    },
    "schema_version": {
      "const": 2
    },
    "archive_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "github_outer_compression",
        "max_expanded_size",
        "max_member_count",
        "max_member_size",
        "release_asset_integrity"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "github_outer_compression": {
          "type": "string",
          "minLength": 1
        },
        "max_expanded_size": {
          "type": "integer",
          "minimum": 1
        },
        "max_member_count": {
          "type": "integer",
          "minimum": 1
        },
        "max_member_size": {
          "type": "integer",
          "minimum": 1
        },
        "release_asset_integrity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "release_toolchains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/releaseToolchain" }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lockedComponent" }
    }
  },
  "$defs": {
    "licenseFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^release/licenses/[A-Za-z0-9.+_-]+\\.txt$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "embeddedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "source_path",
        "license_expression",
        "license_files"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "license_expression": {
          "type": "string",
          "minLength": 1
        },
        "license_files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/licenseFile" }
        }
      }
    },
    "artifactFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "path", "sha256"],
      "properties": {
        "component_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.+_/-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "archive_filename", "sha512"],
      "properties": {
        "component_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "archive_filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.+_-]+\\.tar\\.(gz|xz)$"
        },
        "sha512": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      }
    },
    "releaseToolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "image",
        "image_component",
        "toolchain_component",
        "archive_root",
        "compiler",
        "producer_build_log",
        "source_evidence",
        "runtime_files"
      ],
      "properties": {
        "id": {
          "const": "linux-musl-x86_64"
        },
        "target": {
          "const": "x86_64-unknown-linux-musl"
        },
        "image": {
          "type": "string",
          "pattern": "^[^ @]+@sha256:[0-9a-f]{64}$"
        },
        "image_component": {
          "const": "linux-build-image"
        },
        "toolchain_component": {
          "const": "linux-musl-toolchain"
        },
        "archive_root": {
          "const": "x86_64-unknown-linux-musl"
        },
        "compiler": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "target", "version"],
          "properties": {
            "path": {
              "const": "bin/x86_64-unknown-linux-musl-g++"
            },
            "target": {
              "const": "x86_64-unknown-linux-musl"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          }
        },
        "producer_build_log": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {
              "const": "build.log.bz2"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "source_evidence": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/sourceEvidence" }
        },
        "runtime_files": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": { "$ref": "#/$defs/artifactFile" }
        }
      }
    },
    "lockedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "scope",
        "lock_state",
        "integration",
        "source_repository",
        "source_archive",
        "immutable_ref",
        "version",
        "archive_sha256",
        "archive_size",
        "license_expression",
        "license_files",
        "embedded_components"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "enum": ["runtime", "release-runtime", "test-only", "build-only"]
        },
        "lock_state": {
          "const": "locked"
        },
        "integration": {
          "enum": [
            "fetchcontent",
            "fetchcontent-or-pinned-prefix",
            "release-source-build",
            "release-toolchain-runtime",
            "release-host-tool-source",
            "release-input-artifact",
            "pinned-build-image",
            "test-fetchcontent"
          ]
        },
        "source_repository": {
          "type": "string",
          "pattern": "^https://"
        },
        "source_archive": {
          "type": "string",
          "pattern": "^https://"
        },
        "immutable_ref": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "archive_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "archive_size": {
          "type": "integer",
          "minimum": 1
        },
        "source_tree_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generated_source_tree_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "license_expression": {
          "type": "string",
          "minLength": 1
        },
        "license_files": {
          "type": "array",
          "items": { "$ref": "#/$defs/licenseFile" }
        },
        "embedded_components": {
          "type": "array",
          "items": { "$ref": "#/$defs/embeddedComponent" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "integration": {
                "enum": [
                  "fetchcontent",
                  "fetchcontent-or-pinned-prefix",
                  "release-source-build",
                  "release-host-tool-source",
                  "test-fetchcontent"
                ]
              }
            },
            "required": ["integration"]
          },
          "then": {
            "required": ["source_tree_sha256"]
          },
          "else": {
            "not": {
              "required": ["source_tree_sha256"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": { "const": "tdlib" }
            },
            "required": ["id"]
          },
          "then": {
            "required": ["generated_source_tree_sha256"]
          },
          "else": {
            "not": {
              "required": ["generated_source_tree_sha256"]
            }
          }
        }
      ]
    }
  }
}
